# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy support (use VITE_SUPABASE_PUBLISHABLE_KEY instead)
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Error logs and feedback (optional; see documentation/DOC_ERROR_LOGGING_CONTRACT.md)
# Deploy environment tag: preview | staging | production (localhost is always local_dev)
# VITE_APP_ENVIRONMENT=production
# Release tag; defaults to the package.json version
# VITE_APP_VERSION=
# Feedback app label; defaults to "app"
# VITE_APP_ID=app

# Airtable Configuration
# Get these from: https://airtable.com/create/tokens
VITE_AIRTABLE_API_KEY=your-api-key
VITE_AIRTABLE_BASE_ID=your-base-id
VITE_AIRTABLE_TABLE_ID=your-table-id
