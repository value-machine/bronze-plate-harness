{
  "color": {
    "$type": "color",
    "$description": "Semantic colors (dark). CSS: --<name>.",
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0275, 0.0235, 0.0784],
        "hex": "#070614"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "card": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1098, 0.1059, 0.1608],
        "hex": "#1c1b29"
      }
    },
    "card-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "popover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1098, 0.1059, 0.1608],
        "hex": "#1c1b29"
      }
    },
    "popover-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8118, 0.0745, 0.702],
        "hex": "#cf13b3"
      }
    },
    "primary-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "primary-gradient-start": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.5529, 0.0431, 0.8196],
        "hex": "#8d0bd1"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.902, 0.098, 0.4196],
        "hex": "#e6196b"
      }
    },
    "secondary-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.149, 0.1451, 0.2275],
        "hex": "#26253a"
      }
    },
    "muted-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.702, 0.702, 0.7608],
        "hex": "#b3b3c2"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "alpha": 0.08,
        "hex": "#ffffff"
      }
    },
    "accent-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "destructive": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9569, 0.2627, 0.2118],
        "hex": "#f44336"
      }
    },
    "destructive-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.4, 0.7333, 0.4157],
        "hex": "#66bb6a"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.6549, 0.149],
        "hex": "#ffa726"
      }
    },
    "info": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1608, 0.7137, 0.9647],
        "hex": "#29b6f6"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "alpha": 0.12,
        "hex": "#ffffff"
      }
    },
    "input": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "alpha": 0.23,
        "hex": "#ffffff"
      }
    },
    "ring": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8118, 0.0745, 0.702],
        "alpha": 0.5,
        "hex": "#cf13b3"
      }
    },
    "overlay": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0.6,
        "hex": "#000000"
      }
    },
    "scrollbar": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "alpha": 0.3,
        "hex": "#ffffff"
      }
    },
    "scrollbar-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "alpha": 0.5,
        "hex": "#ffffff"
      }
    }
  },
  "elevation": {
    "$type": "shadow",
    "elevation-brand": {
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 0.4,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 3,
            "unit": "px"
          },
          "blur": {
            "value": 5,
            "unit": "px"
          },
          "spread": {
            "value": 2,
            "unit": "px"
          }
        }
      ]
    },
    "elevation-brand-active": {
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 0.5,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 2,
            "unit": "px"
          },
          "blur": {
            "value": 4,
            "unit": "px"
          },
          "spread": {
            "value": 1,
            "unit": "px"
          }
        }
      ]
    }
  }
}
