{
  "color": {
    "$type": "color",
    "$description": "Semantic colors (light). CSS: --<name>.",
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0784, 0.0745, 0.1216],
        "hex": "#14131f"
      }
    },
    "card": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "card-foreground": {
      "$value": {
        "colorSpace": "srgb",
