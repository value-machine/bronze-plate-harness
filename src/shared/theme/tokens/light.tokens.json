        "colorSpace": "srgb",
        "components": [0.8118, 0.0745, 0.702],
        "hex": "#cf13b3"
      }
    },
    "primary-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "primary-gradient-start": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.5529, 0.0431, 0.8196],
        "hex": "#8d0bd1"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
