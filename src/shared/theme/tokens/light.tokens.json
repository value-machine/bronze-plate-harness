        "hex": "#14131f"
      }
    },
    "scrollbar": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0784, 0.0745, 0.1216],
        "alpha": 0.3,
        "hex": "#14131f"
      }
    },
    "scrollbar-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0784, 0.0745, 0.1216],
        "alpha": 0.5,
        "hex": "#14131f"
      }
    }
  },
  "elevation": {
    "$type": "shadow",
    "elevation-brand": {
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 0.15,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 3,
            "unit": "px"
          },
          "blur": {
            "value": 5,
            "unit": "px"
          },
          "spread": {
            "value": 2,
            "unit": "px"
          }
        }
      ]
    },
    "elevation-brand-active": {
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 0.2,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 2,
            "unit": "px"
          },
          "blur": {
            "value": 4,
            "unit": "px"
          },
          "spread": {
            "value": 1,
            "unit": "px"
          }
        }
      ]
    }
  }
}
