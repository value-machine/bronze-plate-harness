        "colorSpace": "srgb",
        "components": [0.1804, 0.4902, 0.1961],
        "hex": "#2e7d32"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.651, 0.3451, 0],
        "hex": "#a65800"
      }
    },
    "info": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0078, 0.4667, 0.7412],
        "hex": "#0277bd"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0784, 0.0745, 0.1216],
        "alpha": 0.12,
        "hex": "#14131f"
      }
    },
    "input": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0784, 0.0745, 0.1216],
